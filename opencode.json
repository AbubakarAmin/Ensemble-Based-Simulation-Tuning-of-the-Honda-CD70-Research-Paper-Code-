{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "*": "allow",
    "doom_loop": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf data*": "deny",
      "rm -rf src*": "deny",
      "rm -rf config*": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "pip install *": "deny",
      "python -m pip install *": "deny",
      "py -m pip install *": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "git config*": "deny",
      "git remote*": "deny",
      "del /s*": "deny",
      "rmdir /s*": "deny",
      "rd /s*": "deny",
      "Remove-Item*": "deny",
      "format *": "deny",
      "shutdown*": "deny",
      "pip install -r requirements.txt*": "allow",
      "python -m pip install -r requirements.txt*": "allow",
      "py -m pip install -r requirements.txt*": "allow"
    },
    "edit": {
      "*": "allow",
      "src/cd70/*.py": "deny",
      "src/cd70/data/*": "deny",
      "tests/locked/*": "deny",
      "config/*": "deny",
      "docs/*": "deny",
      "tasks/*": "deny",
      "scripts/*.py": "deny",
      "AGENTS.md": "deny",
      "README.md": "deny",
      "opencode.json": "deny",
      "pyproject.toml": "deny",
      "requirements.txt": "deny",
      ".opencode/*": "deny",
      "state/*": "deny",
      "src/cd70/custom/*": "allow",
      "scripts/custom/*": "allow",
      "tests/custom/*": "allow",
      "data/raw/*": "deny",
      "paper/*": "deny",
      "data/processed/*": "deny"
    }
  }
}